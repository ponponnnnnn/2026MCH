PORT=8080
GEMINI_API_KEY=AQ.Ab8RN6L-L7ACKyAPr5nVValDwQHGDCQbRnDiOlHssFSqmnjMtw
LIVE_MODEL=gemini-3.8-live
REPORT_MODEL=gemini-flash-latest
GOOGLE_CLOUD_PROJECT=
# 本機開發用，Cloud Run 上不需要（使用預設服務帳戶）
# GOOGLE_APPLICATION_CREDENTIALS=./service-account.json

# Gmail 寄信（未設定則只印 log）
# GMAIL_APP_PASSWORD：寄件帳號開啟兩步驟驗證後，於 Google 帳戶「應用程式密碼」產生的 16 碼
GMAIL_USER=
GMAIL_APP_PASSWORD=
# 收件人備援：elders/{id}.familyContacts[].email 為空時使用，逗號分隔
FAMILY_EMAILS=

# 保護 /jobs/* 的共享密鑰（Cloud Scheduler 以 x-job-secret header 帶入）
JOB_SECRET=
# 家屬儀表板網址（放進晚報連結）
DASHBOARD_URL=http://localhost:5173
# 預設長輩 ID（MVP 單一長輩）
DEFAULT_ELDER_ID=demo
# 1 = 不連 Firestore，只驗證語音（tool call 只印 log）
DEV_NO_DB=1

# Demo：開放 POST /demo/daily-report（App 的「立即產生晚報」按鈕），正式環境請移除
DEMO_MODE=1
